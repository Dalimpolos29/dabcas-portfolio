# Contact form delivery (optional).
# Without these three values the contact form tells visitors to email you
# directly instead of silently failing.
#
# 1. Create a free account at https://resend.com and verify dabcas.dev
# 2. Create an API key, then set these in Vercel → Settings → Environment Variables
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@dabcas.dev
CONTACT_FROM_EMAIL=website@dabcas.dev
