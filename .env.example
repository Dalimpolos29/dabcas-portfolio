# Contact form delivery (optional).
# Without these three values the contact form tells visitors to email you
# directly instead of silently failing.
#
# 1. Create a free account at https://resend.com and verify whichever domain
#    you're sending from — Resend requires a verified sender domain before
#    CONTACT_FROM_EMAIL will deliver.
# 2. Create an API key, then set these in Vercel → Settings → Environment Variables
RESEND_API_KEY=
CONTACT_TO_EMAIL=imdennisalimpolos@gmail.com
CONTACT_FROM_EMAIL=your-verified-sender@your-domain.example
